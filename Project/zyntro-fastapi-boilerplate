# patent_landscape_to_zyntroai.py
import json

def export_to_zyntroai(patent_data, output_path):
    """แปลงข้อมูลสิทธิบัตรให้ ZyntroAI Agents อ่านและทำงานต่อได้"""
    zyntro_payload = {
        "knowledge_domain": "patent_intelligence",
        "entities": patent_data["patents"],
        "relations": [
            {
                "from": p["id"],
                "to": c["id"],
                "type": "belongs_to_category"
            }
            for p in patent_data["patents"]
            for c in patent_data["categories"]
            if p["category_id"] == c["id"]
        ],
        "signals": {
            "commercial_heatmap": {
                p["id"]: p["commercial_signal"]["score"] / 15
                for p in patent_data["patents"]
            },
            "opportunity_zones": patent_data["white_space_opportunities"]
        },
        "orchestration_hints": {
            "research_agent_priority": ["WS-001", "WS-002"],
            "monitoring_agent_frequency": "daily",
            "reporting_agent_format": "executive_summary"
        }
    }
    
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(zyntro_payload, f, ensure_ascii=False, indent=2)
    
    return f"ส่งออกสำเร็จ → {output_path}"

