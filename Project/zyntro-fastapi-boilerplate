#!/bin/bash
set -e

echo "🧠 เริ่มต้นโปรเจกต์ ZyntroAI"
echo "============================"

REPO_DIR="ZyntroAI-Project"

# ====== โคลนหรือสร้าง ======
if [ ! -d "$REPO_DIR" ]; then
  echo "📥 ดึงโค้ด..."
  git clone git@github.com:zyntromedia/ZyntroAI-Project.git "$REPO_DIR"
  cd "$REPO_DIR"
else
  echo "📂 มีโฟลเดอร์แล้ว — ดึงข้อมูลล่าสุด"
  cd "$REPO_DIR"
  git pull origin main
fi

# ====== ตั้งค่าสภาพแวดล้อม ======
if [ ! -f .env ]; then
  echo "⚙️  คัดลอก .env..."
  cp .env.example .env
  echo "⚠️  กรุณาแก้ไข .env → ตั้งค่า DATABASE_URL และคีย์ต่างๆ"
fi

# ====== ติดตั้งแพ็กเกจ ======
echo "📦 ติดตั้งแพ็กเกจ..."
if [ -f pyproject.toml ]; then
  uv sync --dev
fi
if [ -f package.json ]; then
  npm install
fi

# ====== Prisma (ถ้ามี) ======
if [ -d prisma ]; then
  npx prisma generate
fi

echo ""
echo "✅ พร้อมแล้ว! 🚀"
echo "cd $REPO_DIR"
echo "npm run dev"
 
 
