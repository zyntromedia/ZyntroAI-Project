#!/bin/bash
set -e

echo "🧠 ZyntroAI — ตรวจสอบระบบ"
echo "============================"

check() {
  if command -v $1 &> /dev/null; then
    echo "✅ $2: $(($3 --version 2>/dev/null || echo "ติดตั้งแล้ว"))"
  else
    echo "❌ $2: ยังไม่ติดตั้ง"
    MISSING+=("$1")
  fi
}

MISSING=()

check git "Git"
check python3 "Python"
check node "Node.js"
check uv "uv"
check pnpm "pnpm"
check docker "Docker"

echo "============================"
if [ ${#MISSING[@]} -eq 0 ]; then
  echo "🎉 ทุกอย่างพร้อมแล้ว!"
else
  echo "⚠️  ยังขาด: ${MISSING[*]}"
  exit 1
fi
 
 
