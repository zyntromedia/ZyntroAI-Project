#!/bin/bash
set -e

RC_FILE="$HOME/.zshrc"
if [[ "$SHELL" == *bash* ]]; then
  RC_FILE="$HOME/.bashrc"
fi

echo "🧠 ตั้งค่าเทอร์มินัล — ZyntroAI"
echo "============================"

MARKER="# === ZYNTROAI START ==="
if grep -q "$MARKER" "$RC_FILE"; then
  echo "✅ ตั้งค่าไว้แล้ว"
  exit 0
fi

cat >> "$RC_FILE" << 'EOF'

# === ZYNTROAI START ===
# 🧠 ZyntroAI — Terminal Shortcuts
# =================================

# สี
export GREY='\033[1;30m'
export RED='\033[0;31m'
export GREEN='\033[0;32m'
export YELLOW='\033[1;33m'
export BLUE='\033[0;34m'
export PURPLE='\033[0;35m'
export CYAN='\033[0;36m'
export WHITE='\033[1;37m'
export RESET='\033[0m'

# Prompt
export PS1="\n\[\$CYAN\]🧠 ZyntroAI \[\$GREEN\]\w\[\$RESET\] \$ "

# ====== คำสั่งลัด ======
alias z-start="cd ~/Projects/ZyntroAI-Project"
alias z-dev="z-start && npm run dev"
alias z-sync="z-start && git add . && git commit -m 'update' && git push"
alias z-migrate="z-start && npx prisma migrate dev"
alias z-deploy="z-start && npx vercel --prod"
alias z-check="z-start && npm run lint && npm run build"

# ====== สถานะด่วน ======
alias z-status="echo '🧠 ZyntroAI Status' && git status"
alias z-log="git log --oneline --graph -10"

# === ZYNTROAI END ===
EOF

echo "✅ เพิ่มการตั้งค่าใน $RC_FILE"
echo "รันคำสั่งนี้เพื่อใช้ทันที:"
echo "source $RC_FILE"
 
 
